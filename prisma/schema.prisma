generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  MASTER_ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String
  name            String
  role            String         @default("PATIENT") // Keep as string for now to avoid migration friction with existing data, but we'll use "MASTER_ADMIN" as a value
  isVerified      Boolean        @default(false)
  publicId        String         @unique // For ST-XXXX format
  verificationDoc String?        // URL to ID/license image
  
  // Profile (1-to-1)
  profile         Profile?

  // Relations
  records         MedicalRecord[]  @relation("PatientRecords")
  medications     Medication[]     @relation("UserMedications")
  medicalFiles    MedicalFile[]    @relation("UserFiles")
  
  messagesSent    Message[]        @relation("MessageSender")
  messagesRecv    Message[]        @relation("MessageReceiver")
  
  notifications   Notification[]   @relation("UserNotifications")
  
  // Friend Requests (Social)
  sentRequests     FriendRequest[] @relation("RequestSender")
  receivedRequests  FriendRequest[] @relation("RequestReceiver")
  
  // Doctor Invitations
  sentInvites      DoctorInvitation[] @relation("DoctorInvite")
  receivedInvites  DoctorInvitation[] @relation("PatientInvite")

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  height        String?  // e.g. "175cm"
  weight        String?  // e.g. "70kg"
  bloodType     String?  // e.g. "A+"
  gender        String?  
  dob           DateTime?
  address       String?
  profileImage  String?
}

model MedicalFile {
  id          String   @id @default(uuid())
  name        String   // "Chest X-Ray", "Blood Test Report"
  fileUrl     String
  fileType    String   @default("IMAGE") // IMAGE, PDF
  userId      String
  user        User     @relation("UserFiles", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Medication {
  id          String   @id @default(uuid())
  name        String
  dosage      String
  frequency   String
  startDate   DateTime @default(now())
  endDate     DateTime?
  status      String   @default("CURRENT") // CURRENT, COMPLETED
  userId      String
  user        User     @relation("UserMedications", fields: [userId], references: [id], onDelete: Cascade)
}

model FriendRequest {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  sender      User     @relation("RequestSender", fields: [senderId], references: [id])
  receiver    User     @relation("RequestReceiver", fields: [receiverId], references: [id])
  createdAt   DateTime @default(now())
  
  @@unique([senderId, receiverId])
}

model DoctorInvitation {
  id          String   @id @default(uuid())
  doctorId    String
  patientId   String
  status      String   @default("PENDING")
  doctor      User     @relation("DoctorInvite", fields: [doctorId], references: [id])
  patient     User     @relation("PatientInvite", fields: [patientId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([doctorId, patientId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model MedicalRecord {
  id              String   @id @default(uuid())
  title           String
  content         String?  // Text notes / Diagnosis
  type            String   @default("NOTE") // "DIAGNOSIS" | "PRESCRIPTION" | "NOTE" | "ALERT"
  fileUrl         String?  // Link to PDF/Image
  isPinned        Boolean  @default(false)
  requiresAction  Boolean  @default(false) // For alerts/emergencies
  tags            String?  // Comma separated e.g. "Diet, Exercise"
  
  patientId       String
  patient         User     @relation("PatientRecords", fields: [patientId], references: [id])
  
  createdAt       DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserNotifications", fields: [userId], references: [id])
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}
