generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  MASTER_ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String
  name            String
  role            String         @default("PATIENT") // PATIENT, DOCTOR, MASTER_ADMIN, SUPER_ADMIN
  isVerified      Boolean        @default(false)
  publicId        String         @unique // For ST-XXXX format
  verificationDoc String?        // URL to ID/license image
  requestedRole   String?        @default("PATIENT")
  
  // Scoping (Multi-Tenancy)
  hospitalId      String?
  hospital        Hospital?      @relation(fields: [hospitalId], references: [id])
  branchId        String?
  branch          Branch?        @relation(fields: [branchId], references: [id])

  // Profile (1-to-1)
  profile         Profile?

  // Relations
  records         MedicalRecord[]  @relation("PatientRecords")
  medications     Medication[]     @relation("UserMedications")
  medicalFiles    MedicalFile[]    @relation("UserFiles")
  
  messagesSent    Message[]        @relation("MessageSender")
  messagesRecv    Message[]        @relation("MessageReceiver")
  
  notifications   Notification[]   @relation("UserNotifications")
  
  // Appointments
  appointmentsDoc  Appointment[]   @relation("DoctorAppointments")
  appointmentsPat  Appointment[]   @relation("PatientAppointments")

  // AI Chat
  aiConversations  AiConversation[] @relation("UserAiConversations")
  
  // Friend Requests (Social)
  sentRequests     FriendRequest[] @relation("RequestSender")
  receivedRequests  FriendRequest[] @relation("RequestReceiver")
  
  // Doctor Invitations
  sentInvites      DoctorInvitation[] @relation("DoctorInvite")
  receivedInvites  DoctorInvitation[] @relation("PatientInvite")

  // Memberships
  memberships      BranchMembership[] @relation("UserMemberships")

  // Branch Governance
  managedBranch    Branch?         @relation("BranchMaster")

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Hospital {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  domain      String?  @unique
  branches    Branch[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Branch {
  id            String   @id @default(uuid())
  name          String
  address       String?
  hospitalId    String
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  masterAdminId String?  @unique
  masterAdmin   User?    @relation("BranchMaster", fields: [masterAdminId], references: [id])
  
  users         User[]
  appointments  Appointment[]
  memberships   BranchMembership[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BranchMembership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  role      String   // DOCTOR, PATIENT
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@unique([userId, branchId])
}

model HospitalRequest {
  id              String   @id @default(uuid())
  requesterId     String
  hospitalName    String
  branchName      String
  branchAddress   String
  documentUrl     String?  // Legal/Clinical docs
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Appointment {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      User     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patientId   String
  patient     User     @relation("PatientAppointments", fields: [patientId], references: [id])
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  
  startTime   DateTime
  endTime     DateTime?
  status      String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  meetingUrl  String?  // For Daily.co linkage
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation("UserAiConversations", fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // user, bot
  content        String
  createdAt      DateTime       @default(now())
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  height        String?  // e.g. "175cm"
  weight        String?  // e.g. "70kg"
  bloodType     String?  // e.g. "A+"
  gender        String?  
  dob           DateTime?
  address       String?
  profileImage  String?
}

model MedicalFile {
  id          String   @id @default(uuid())
  name        String   // "Chest X-Ray", "Blood Test Report"
  fileUrl     String
  fileType    String   @default("IMAGE") // IMAGE, PDF
  userId      String
  user        User     @relation("UserFiles", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Medication {
  id          String   @id @default(uuid())
  name        String
  dosage      String
  frequency   String
  startDate   DateTime @default(now())
  endDate     DateTime?
  status      String   @default("CURRENT") // CURRENT, COMPLETED
  userId      String
  user        User     @relation("UserMedications", fields: [userId], references: [id], onDelete: Cascade)
}

model FriendRequest {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  sender      User     @relation("RequestSender", fields: [senderId], references: [id])
  receiver    User     @relation("RequestReceiver", fields: [receiverId], references: [id])
  createdAt   DateTime @default(now())
  
  @@unique([senderId, receiverId])
}

model DoctorInvitation {
  id          String   @id @default(uuid())
  doctorId    String
  patientId   String
  status      String   @default("PENDING")
  doctor      User     @relation("DoctorInvite", fields: [doctorId], references: [id])
  patient     User     @relation("PatientInvite", fields: [patientId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([doctorId, patientId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model MedicalRecord {
  id              String   @id @default(uuid())
  title           String
  content         String?  // Text notes / Diagnosis
  type            String   @default("NOTE") // "DIAGNOSIS" | "PRESCRIPTION" | "NOTE" | "ALERT"
  fileUrl         String?  // Link to PDF/Image
  isPinned        Boolean  @default(false)
  requiresAction  Boolean  @default(false) // For alerts/emergencies
  tags            String?  // Comma separated e.g. "Diet, Exercise"
  
  patientId       String
  patient         User     @relation("PatientRecords", fields: [patientId], references: [id])
  
  createdAt       DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserNotifications", fields: [userId], references: [id])
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}
